# =============================================================================
# Sovereign Agent Node — environment configuration
# =============================================================================
# Copy this file to .env and fill in all REQUIRED values before running:
#   cp .env.example .env
#
# REQUIRED values must be set; the stack will refuse to start without them.
# OPTIONAL values have safe defaults; leave blank to use the default.
# =============================================================================


# ─── Database ────────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL password. No default; must be set.
# Generate: openssl rand -base64 32
DB_PASSWORD=

# OPTIONAL — PostgreSQL username (default: vantage)
DB_USER=vantage


# ─── Vantage (civilization interface, port 8000) ─────────────────────────────

# REQUIRED — Django/FastAPI secret key. Used for session signing and CSRF.
# Generate: openssl rand -hex 32
SECRET_KEY=

# OPTIONAL — Internal API key used by protocol brokers to authenticate to Vantage.
# Generate: openssl rand -hex 32
# Leave empty to disable broker→Vantage authenticated calls.
VANTAGE_INTERNAL_KEY=


# ─── Node identity (DIP + VCP) ───────────────────────────────────────────────

# REQUIRED — Ed25519 hex secret key for this node's DIP/VCP identity.
# Each node must have a unique key; this is how peers recognise you on the mesh.
# Generate: openssl rand -hex 32
NODE_SECRET_KEY=


# ─── UCX — Universal Compute Exchange (port 7790) ────────────────────────────

# OPTIONAL — GPU.ai API key for external GPU compute routing.
# Leave empty to run UCX in native-only mode (Vantage-registered providers only).
# Get from: https://api.gpu.ai
UCX_GPUAI_MASTER_KEY=


# ─── DIP — Decentralized Interoperability Protocol (port 7792) ───────────────

# OPTIONAL — Comma-separated peer node URLs for DIP federation.
# Leave empty to run as an isolated node (still accepts inbound DIP envelopes).
# Example: https://node2.example.com,https://node3.example.com
DIP_PEER_NODES=


# ─── Witness (Nostr attestation, port 7794) ──────────────────────────────────

# OPTIONAL — Nostr relay URLs for WitnessAttestation (kind 31020) publication.
# Default: wss://relay.damus.io,wss://nos.lol
AGENT_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol


# ─── ScarabSwarm / OSOVM (port 7793) ─────────────────────────────────────────

# OPTIONAL — URL of a running OSOVM simulation engine.
# Leave empty to run ScarabSwarm in standalone mode (receipts stored locally).
# Example: http://osovm:8080
OSOVM_URL=


# ─── Agent mesh (optional federation features) ───────────────────────────────

# OPTIONAL — Email domain for agent mailboxes (NIP-05 / BIPON39 addressing).
# Example: agents.yourdomain.com
AGENT_MAIL_DOMAIN=


# ─── Master env var reference (all ecosystem services) ───────────────────────
# Canonical port map:
#   Vantage      8000   Omo-Koda2   8001   Zangbeto    8787
#   OSOVM/Waggle 7778   UCX         7790   VCP         7791
#   DIP          7792   ScarabSwarm 7793   Witness     7794
#   ARP          7795   minipae    30174   Agent-Phone  8765

# ── Chain / network identity ─────────────────────────────────────────────────
CHAIN_ID=mainnet

# ── Service URLs ──────────────────────────────────────────────────────────────
# Zangbeto behavioral enforcement daemon. Fail-open when unset.
ZANGBETO_URL=http://localhost:8787
VANTAGE_URL=http://localhost:8000
# OSOVM_URL is also declared above in the ScarabSwarm section.
# Repeated here as the canonical reference for all other crates.
# OSOVM_URL=http://localhost:7778
DIP_URL=http://localhost:7792
VCP_URL=http://localhost:7791
UCX_URL=http://localhost:7790
ARP_URL=http://localhost:7795
# Waggle shares the OSOVM port
WAGGLE_URL=http://localhost:7778
MINIPAE_URL=http://localhost:30174
AGENT_PHONE_URL=http://localhost:8765

# ── Nostr ─────────────────────────────────────────────────────────────────────
NOSTR_RELAY_URL=wss://relay.damus.io

# ── Secrets — REQUIRED in production, leave empty for local dev ───────────────
# GPU.ai compute marketplace API key (get from api.gpu.ai)
GPUAI_API_KEY=
# 32-byte hex seed for Witness Nostr key-pair
WITNESS_NOSTR_KEY=
# 32-byte hex seed used to sign ARP / economic receipts
BROKER_SIGNING_KEY=
# 32-byte hex seed used by the DIP bridge for envelope signatures
DIP_SIGNING_KEY=

# ── Security / verification feature flags ─────────────────────────────────────
# Set to true in production once VCP device certs are issued
VCP_REQUIRE_PUBKEY=false
# Set to true once DIP signing keys are distributed to all peers
DIP_REQUIRE_SIGNATURES=false

# ── Experimental language runtimes ────────────────────────────────────────────
# Enable LARQL GlyphIndex query engine (Phase 22+)
LARQL_ENABLED=false
# Enable ZeroLang graph-executable runtime (Phase 23+)
ZEROLANG_ENABLED=false

# ── Night Patrol ──────────────────────────────────────────────────────────────
# How often Zangbeto scans for anomalies (seconds). Default = 1 hour.
PATROL_INTERVAL_SECS=3600
